#include<stdio.h>
int main()
{
    int marks[5];
    int i;
    printf("Enter 5 marks:\n");
    for( i=0; i<5; i++) {
        printf("Enter mark %d: ", i+1);
        scanf(" %d", &marks[i]);

        if (marks[i]<0 ||marks[i]>100){
            printf("Invalid! Marks must be 0 - 100. Try again.\n");
            i--;
        }
    }
    printf("\nYou entered :\n");
    for ( i=0; i<5; i++){
        printf("%d ",marks[i]);
    }
    int max = marks[0];
    for( i=1; i<5; i++) {
        if(marks[i]>max){
            max = marks[i];
        }
    }
    printf("\nHighest mark is:%d\n ", max);
    return 0;
}
